# ==================================================================================================
# Copilot Gateway Configuration
# ==================================================================================================

# API key for proxy access (clients must pass this in Authorization header)
PROXY_API_KEY="my-super-secret-password-123"

# ==================================================================================================
# GitHub Copilot Credentials (choose one)
# ==================================================================================================

# Option 1: Auto-detect from VS Code's local database (default, no config needed)
# The gateway automatically reads from VS Code's state.vscdb

# Option 2: Override database path
# COPILOT_VSCODE_DB_FILE="/path/to/state.vscdb"

# Option 3: Direct GitHub token (personal access token or OAuth token)
# GITHUB_TOKEN="your_github_token_here"

# ==================================================================================================
# Server Settings
# ==================================================================================================

# COPILOT_SERVER_HOST="0.0.0.0"
# COPILOT_SERVER_PORT=8002

# ==================================================================================================
# Optional Settings
# ==================================================================================================

# VPN/Proxy for accessing GitHub Copilot API
# VPN_PROXY_URL=http://127.0.0.1:7890

# Logging level (TRACE, DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Streaming timeouts
# FIRST_TOKEN_TIMEOUT=15
# STREAMING_READ_TIMEOUT=300
