# ==================================================================================================
# Cursor Gateway Configuration
# ==================================================================================================

# API key for proxy access (clients must pass this in Authorization header)
PROXY_API_KEY="my-super-secret-password-123"

# ==================================================================================================
# Cursor Credentials (choose one)
# ==================================================================================================

# Option 1: Auto-detect from Cursor's local database (default, no config needed)
# The gateway automatically reads from Cursor's state.vscdb

# Option 2: Override database path
# CURSOR_DB_FILE="/path/to/state.vscdb"

# Option 3: Direct token (from Cursor's SQLite or browser DevTools)
# CURSOR_ACCESS_TOKEN="your_jwt_token_here"
# CURSOR_MACHINE_ID="your_machine_id_here"

# ==================================================================================================
# Server Settings
# ==================================================================================================

# CURSOR_SERVER_HOST="0.0.0.0"
# CURSOR_SERVER_PORT=8001

# ==================================================================================================
# Optional Settings
# ==================================================================================================

# Cursor API host (default: https://api2.cursor.sh)
# CURSOR_API_HOST="https://api2.cursor.sh"

# Client version to spoof (default: 3.2.21)
# CURSOR_CLIENT_VERSION="3.2.21"

# Ghost mode / privacy mode (default: true)
# CURSOR_GHOST_MODE=true

# VPN/Proxy for accessing Cursor API
# VPN_PROXY_URL=http://127.0.0.1:7890

# Logging level (TRACE, DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Streaming timeouts
# FIRST_TOKEN_TIMEOUT=15
# STREAMING_READ_TIMEOUT=300

# ==================================================================================================
# Run Mode (choose one — do not run both on the same port)
# ==================================================================================================
#
# Mode 1: Native Python (recommended on macOS)
#   python3.10 -m venv .venv
#   .venv/bin/pip install -r requirements.txt
#   ./scripts/cursor-gateway.sh native start
#   ./scripts/cursor-gateway.sh native stop
#   ./scripts/cursor-gateway.sh native status
#
# Mode 2: OrbStack / Docker (Linux container, mounts host Cursor DB)
#   ./scripts/cursor-gateway.sh docker up -d --build
#   ./scripts/cursor-gateway.sh docker down
#   ./scripts/cursor-gateway.sh docker logs -f
#
# Shorthand:
#   ./scripts/cursor-gateway.sh start           # native
#   ./scripts/cursor-gateway.sh start --docker  # orbstack
#   ./scripts/cursor-gateway.sh status          # show both
#
# Native mode auto-detects macOS Cursor DB path.
# Docker mode sets CURSOR_DB_FILE=/cursor-data/state.vscdb via compose.
#
# If `docker` fails after switching to OrbStack, unset DOCKER_HOST
# (it may still point at Docker Desktop):
#   unset DOCKER_HOST
#   docker context use orbstack
#
# VPN proxy:
#   Native:  VPN_PROXY_URL=http://127.0.0.1:7890
#   Docker:  VPN_PROXY_URL=http://host.docker.internal:7890
